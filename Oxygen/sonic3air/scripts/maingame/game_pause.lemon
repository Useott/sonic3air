#if STANDALONE

//-------------------------------------------------------//
// Game pause                                            //
//-------------------------------------------------------//

global float GamePause.visibility = 0.0f
global float GamePause.dialogVisibility = 0.0f
global float GamePause.screenshotHint = 0.0f
global u8 GamePause.selectedEntry = 0
global u8 GamePause.dialogEntry = 0
global bool GamePause.isDialogOpen = false
global bool GamePause.hasRestart = false
global bool GamePause.hasOptions = false
global bool GamePause.useTouchInput = false

constant u16 GamePause.NUM_ENTRIES = 4

constant string GamePause.MENU_FONT   = "sonic3_fontC:gradient:outline(0x000000ff,1,false):shadow(1,1,0.5f,1.0f)"
constant string GamePause.DIALOG_FONT = "sonic3_fontB:gradient:outline(0x000000ff,1,false):shadow(1,1,0.5f,0.8f)"
constant string GamePause.TINY_FONT   = "oxyfont_tiny:gradient:outline(0x000000ff,1,false):shadow(1,1,0.5f,0.6f)"


//# address-hook(0x0013e4) end(0x0014e4)
function void UpdateGamePause()
{
	if (lives_counter <= 0)
	{
		global.game.paused = false
		return
	}

	// Start button pressed?
	if (control.pad1.pressed & CONTROL_START)
	{
		if (!GamePause.BeginPause())
			return

		global.game.paused = true
		global.frame_state = 0x10

		GamePause.Menu()

		Standalone.onResumeAfterPause()
		global.game.paused = false

	#if GAMEAPP
		// Fix for brief glitch in Blue Spheres special stage
		if (global.game_mode == 0x34)
			BlueSpheres.replacePlaneRendering()
	#endif
	}
}


function bool GamePause.IsValidEntry(u8 selected)
{
	if (selected == 1 && !GamePause.hasRestart)
		return false
	if (selected == 2 && !GamePause.hasOptions)
		return false
	return true
}


function bool GamePause.BeginPause()
{
	if (global.game_mode == 0x0c && isSonicIntro() && global.level_started == 0)
	{
		// Skip AIZ 1 Sonic intro
		//  -> Note that the Knuckles intro has its own handler
		timer.alldata = 0
		checkpoint.number = 1
		checkpoint.x = 0x13a0
		checkpoint.y = 0x041a
		Checkpoint.SaveCurrentState()
		checkpoint.camera.x = 0x1308
		checkpoint.camera.y = 0x0390
		level.restart = 1

		// Prevent game pause
		return false
	}

	// Enter game pause
	return true
}


function void GamePause.Menu()
{
	// Script implementation of game pause
	GamePause.hasRestart = !global.pause_disabled && (global.game_mode == 0x0c && global.stage_type == 0 && u8[0xffffb000 + 0x05] <= base_state.HURT) && !competition_mode.active
	GamePause.hasOptions = !Game.isTimeAttack()

	// Pause currently playing game music and sounds
	Audio.pauseContext(AudioContext.CONTEXT_MUSIC)
	Audio.pauseContext(AudioContext.CONTEXT_SOUND)

#if GAMEAPP
	// Handle skippable cutscene
	bool wasInSkippableCutscene = Game.isInSkippableCutscene()
	Game.endSkippableCutscene()
#endif

	constant float KEY_REPEAT_TIMEOUT = 0.4f
	constant float KEY_REPEAT_DELAY   = 0.125f
	float keyRepeatTimer = KEY_REPEAT_TIMEOUT
	s8 lastPressedInput = -1

	GamePause.visibility = 0.0f
	GamePause.screenshotHint = 0.0f
	GamePause.selectedEntry = 0
	GamePause.dialogEntry = 0
	GamePause.isDialogOpen = false

	float totalTime = 0.0f
	bool screenshotModeActive = false

	u16 screenTouchCounter = 0
	u16 framesSinceLastTouch = 0
	bool ignoreFramesSinceLastTouch

	GamePause.useTouchInput = false

	while (true)
	{
		// Inner loop will be exited once the player selected an entry in the menu
		while (true)
		{
			// During pause, use lifetime context 1 for everything rendered by the pause menu and afterwards (in "PostFrameUpdate" and by ghost sync)
			//  -> This allows for selectively clearing these sprites, texts, etc. in each frame without touching the game's rendered content
			Renderer.resetLifetimeContext(1)
			Renderer.setLifetimeContext(1)

			float deltaSeconds = 1.0f / 60.0f
			totalTime += deltaSeconds

			// Fade-in
			if (GamePause.visibility < 1.0f && !screenshotModeActive)
				GamePause.visibility = min(GamePause.visibility + deltaSeconds * 6.0f, 1.0f)
			else if (GamePause.visibility > 0.0f && screenshotModeActive)
				GamePause.visibility = max(GamePause.visibility - deltaSeconds * 6.0f, 0.0f)

			// Dialog visibility
			if (GamePause.isDialogOpen)
				GamePause.dialogVisibility = min(GamePause.dialogVisibility + deltaSeconds * 5.0f, 1.0f)
			else
				GamePause.dialogVisibility = max(GamePause.dialogVisibility - deltaSeconds * 5.0f, 0.0f)

			// Screenshot hint visibility
			GamePause.screenshotHint = clamp((totalTime - 5.0f) * 1.5f, 0.0f, 1.0f)

			GamePause.DrawMenu(totalTime)

			enableCustomPlaneReset = false	// Maintain custom planes that were set before the pause
			waitForNextFrame()
			enableCustomPlaneReset = false	// ...also for the next frame (relevant in case of e.g. restart)

			// Undo increase of global framecounter (see "VInt.InnerUpdate"), to avoid messing up animations that rely on it
			--global.framecounter

			if (screenshotModeActive)
			{
				if ((Input.buttonPressed(0, BUTTON_A) || Input.buttonPressed(0, BUTTON_B) || Input.buttonPressed(0, BUTTON_X) || Input.buttonPressed(0, BUTTON_Y) || Input.buttonPressed(0, BUTTON_START) || Input.buttonPressed(0, BUTTON_BACK)) || ((touchdebug.use_touch_controls && !(screenTouchX || screenTouchY) && framesSinceLastTouch > 0 && framesSinceLastTouch < 5) && screenTouchCounter < 20))
					screenshotModeActive = false
				if (GamePause.useTouchInput)
				{
					framesSinceLastTouch += 1
					if (screenTouchX || screenTouchY)
					{
						GamePause.selectedEntry = 255
						ignoreFramesSinceLastTouch = false
						framesSinceLastTouch = 0
					}
				}
			}
			else
			{
				if (Input.buttonPressed(0, BUTTON_Y) || (GamePause.selectedEntry == 254 && ((touchdebug.use_touch_controls && !(screenTouchX || screenTouchY) && framesSinceLastTouch > 0 && framesSinceLastTouch < 5) && screenTouchCounter < 20)))
					screenshotModeActive = true

				if (GamePause.useTouchInput)
					Input.setTouchInputMode(TOUCH_INPUT_MODE_HIDDEN_CONTROLS)
				else Input.setTouchInputMode(TOUCH_INPUT_MODE_NORMAL_CONTROLS)

				// Open selected entry
				if (Input.buttonPressed(0, BUTTON_START) || Input.buttonPressed(0, BUTTON_A) || Input.buttonPressed(0, BUTTON_X) || ((touchdebug.use_touch_controls && !(screenTouchX || screenTouchY) && framesSinceLastTouch > 0 && framesSinceLastTouch < 5) && screenTouchCounter < 20))
					break

				if (GamePause.isDialogOpen)
				{
					// Return from dialog
					if (Input.buttonPressed(0, BUTTON_B) || Input.buttonPressed(0, BUTTON_BACK))
					{
						Audio.playAudio(0x5b)
						GamePause.isDialogOpen = false
					}
				}

				if (GamePause.useTouchInput)
				{
					framesSinceLastTouch += 1
					if (screenTouchX || screenTouchY)
					{
						ignoreFramesSinceLastTouch = false
						if (screenshotModeActive)
						{
							GamePause.selectedEntry = 255
						}
						else
						{
							if (GamePause.isDialogOpen)
							{
								if (GamePause.dialogEntry != GamePause.getButtonResultFromTouch() - 1)
								{
									GamePause.dialogEntry = GamePause.getButtonResultFromTouch() - 1
									if (GamePause.dialogEntry < 255)
										playSound(0x5b)
								}
							}
							else
							{
								if (GamePause.selectedEntry != GamePause.getButtonResultFromTouch() - 1)
								{
									GamePause.selectedEntry = GamePause.getButtonResultFromTouch() - 1
									if (GamePause.selectedEntry < 255 && framesSinceLastTouch <= 1)
										playSound(0x5b)
								}
							}
						}
						framesSinceLastTouch = 0
					}
				}

				// Handle key repeat
				s8 currentInput = -1
				{
					if (Input.buttonPressed(BUTTON_UP))
						currentInput = BUTTON_UP
					else if (Input.buttonPressed(BUTTON_DOWN))
						currentInput = BUTTON_DOWN
					else if (lastPressedInput >= 0 && Input.buttonDown(lastPressedInput))
						currentInput = lastPressedInput

					lastPressedInput = currentInput

					if (currentInput == -1)
					{
						// No input at all, so reset key repeat
						keyRepeatTimer = KEY_REPEAT_TIMEOUT
					}
					else if (Input.buttonPressed(currentInput))
					{
						// Input pressed for the first frame now
						keyRepeatTimer = KEY_REPEAT_TIMEOUT
					}
					else
					{
						// Input held down
						keyRepeatTimer -= deltaSeconds
						if (keyRepeatTimer <= 0.001f)
							keyRepeatTimer = KEY_REPEAT_DELAY
						else
							currentInput = -1
					}
				}

				s8 entryChange = (currentInput == BUTTON_UP) ? -1 : (currentInput == BUTTON_DOWN) ? 1 : 0
				if (entryChange != 0)
				{
					Audio.playAudio(0x5b)

					if (GamePause.isDialogOpen)
					{
						u8 numDialogEntries = (GamePause.selectedEntry == 1) ? 3 : 2
						GamePause.dialogEntry = (GamePause.dialogEntry + numDialogEntries + entryChange) % numDialogEntries
					}
					else
					{
						while (true)
						{
							GamePause.selectedEntry = (GamePause.selectedEntry + GamePause.NUM_ENTRIES + entryChange) % GamePause.NUM_ENTRIES
							if (GamePause.IsValidEntry(GamePause.selectedEntry))
								break
						}
					}
				}
			}

			if ((screenTouchX || screenTouchY))
				screenTouchCounter += 1
			else if (!(screenTouchX || screenTouchY) && (framesSinceLastTouch > 20 || ignoreFramesSinceLastTouch))
				screenTouchCounter = 0
		}

		screenTouchX = 0
		screenTouchY = 0
		screenTouchCounter = 0
		framesSinceLastTouch = 20

		// Evaluate which entry was chosen
		if (GamePause.isDialogOpen)
		{
			// Player chose a dialog entry
			if (GamePause.selectedEntry == 1)
			{
				if (GamePause.dialogEntry == 1)
				{
					restartAtCheckpoint()
					break
				}
				else if (GamePause.dialogEntry == 2)
				{
					restartLevel()
					break
				}
				else if (GamePause.dialogEntry < 255)
				{
					// Close dialog again
					GamePause.isDialogOpen = false
				}
			}
			else if (GamePause.selectedEntry == 3)
			{
				if (GamePause.dialogEntry == 1)
				{
				#if GAMEAPP
					// TODO: Properly fade out the game
					Game.returnToMainMenu()
					yieldExecution()
				#endif
					break
				}
				else if (GamePause.dialogEntry < 255)
				{
					// Close dialog again
					GamePause.isDialogOpen = false
				}
			}
		}
		else
		{
			// Player chose a normal entry
			if (GamePause.selectedEntry == 0)
			{
				// Leave this menu again and continue gameplay
				Input.setTouchInputMode(TOUCH_INPUT_MODE_NORMAL_CONTROLS)
				break
			}
			else if (GamePause.selectedEntry == 1)
			{
				if (Game.isTimeAttack())
				{
					global.game.paused = false	// Done here already so the menu can fade out during the following screen fade
					Audio.resumeContext(AudioContext.CONTEXT_MUSIC)
					Audio.resumeContext(AudioContext.CONTEXT_SOUND)
					restartTimeAttack()
					Input.setTouchInputMode(TOUCH_INPUT_MODE_NORMAL_CONTROLS)
					break
				}
				else
				{
					// First open the dialog menu for Restart
					GamePause.isDialogOpen = true
					Audio.playAudio(0x5b)
				}
			}
			else if (GamePause.selectedEntry == 2)
			{
			#if GAMEAPP
				// Open in-game options
				TourMenus.handleFading(1)
				Input.setTouchInputMode(TOUCH_INPUT_MODE_NORMAL_CONTROLS)
				Game.openOptionsMenu()
				TourMenus.handleFading(0)
			#endif
			}
			else if (GamePause.selectedEntry == 3)
			{
				// First open the dialog menu for Exit Game
				GamePause.isDialogOpen = true
				Audio.playAudio(0x5b)
			}
		}
	}

	Renderer.resetLifetimeContext(1)

	// Resume game audio
	Audio.resumeContext(AudioContext.CONTEXT_MUSIC)
	Audio.resumeContext(AudioContext.CONTEXT_SOUND)

#if GAMEAPP
	if (wasInSkippableCutscene)
		Game.startSkippableCutscene()
#endif
}


function void GamePause.UpdateFadeOut()
{
	// Fading already done?
	if (GamePause.visibility <= 0.0f)
		return

	// Don't fade out during pause, only afterwards
	if (global.game.paused)
		return

	Renderer.resetLifetimeContext(1)
	Renderer.setLifetimeContext(1)

	// Fade-out
	float deltaSeconds = 1.0f / 60.0f
	GamePause.visibility = max(GamePause.visibility - deltaSeconds * 6.0f, 0.0f)
	GamePause.dialogVisibility = max(GamePause.dialogVisibility - deltaSeconds * 6.0f, 0.0f)

	// Draw menu unless it just got invisible
	if (GamePause.visibility > 0.0f)
	{
		GamePause.DrawMenu(0.0f)
	}
}


function void GamePause.DrawMenu(float time)
{
	// Ensure that the game pause menu always renders onto the full screen, #contributed by nabbup / Ramona
	Renderer.resetViewport(0xfeff)

	if (System.hasPlatformFlag(PlatformFlags.MOBILE))
		GamePause.useTouchInput = true
	else GamePause.useTouchInput = false

	u16 renderQueue = 0xff00

	Renderer.drawText("sonic3_fontC", getScreenCenterX(), 16 + Math.roundToInt((GamePause.visibility * 32.0f) - 32.0f), Standalone.getTranslatedString("pause", 0), 0xffffffff, 5, 0, renderQueue + 4, false)

	u8 entriesAdded = 0
	u8 i = 0
	for (i = 0; i < GamePause.NUM_ENTRIES; ++i)
	{
		if (!GamePause.IsValidEntry(i))
			continue

		++entriesAdded
	}
	s16 px = 0
	s16 py = 0
	bool removedEntry = false
	for (i = 0; i < entriesAdded; ++i)
	{
		s16 py_ref = Math.lerp(37, getScreenHeight() - 37, float(i) / float(entriesAdded - 1))
		if (!GamePause.IsValidEntry(i))
		{
			++i
			++entriesAdded
			removedEntry = true
		}
		else if (!GamePause.IsValidEntry(i - 1) && removedEntry)
		{
			--i
			--entriesAdded
			removedEntry = false
		}
		py = GamePause.selectedEntry == i ? Math.lerp(py_ref, 64, GamePause.dialogVisibility) : py_ref
		s16 sprOffset = Math.roundToInt(96.0f * Math.sin(2.0f * 3.1415f * 76.0f * float(py)))
		px = (GamePause.selectedEntry == i ? -16 : 0) + sprOffset + getScreenWidth() - 100 + Math.roundToInt(192.0f - (GamePause.visibility * 192.0f))

		Renderer.drawText("oxyfont_regular", px + 16, py, Standalone.getTranslatedString("pause", i + 1), GamePause.selectedEntry == i ? 0xffff00ff : 0xffffffff - Math.roundToInt(GamePause.dialogVisibility * 255.0f), 4, 0, renderQueue + 3, false)
		Renderer.drawSpriteTinted("main_menu.text_bg", px, py, 0, SPRITE_FLAG_FLIP_X|SPRITE_FLAG_PRIO, renderQueue + 2, 0, GamePause.selectedEntry == i ? 0xffffffff : 0x000000ff - Math.roundToInt(GamePause.dialogVisibility * 255.0f), 1.0f)
		py += 38
	}

	if (GamePause.dialogVisibility > 0.0f)
	{
		u8 numDialogEntries = (GamePause.selectedEntry == 1) ? 3 : (GamePause.selectedEntry == 3) ? 2 : 0
		u8 firstText = (GamePause.selectedEntry == 1) ? 0 : 3
		for (i = 0; i < numDialogEntries; ++i)
		{
			px = (GamePause.dialogEntry == i ? -16 : 0) + getScreenWidth() - 144 + Math.roundToInt(192.0f - (GamePause.visibility * 192.0f))
			Renderer.drawText("oxyfont_small", px + 16, 104 + (32 * i), Standalone.getTranslatedString("pause", 5 + firstText + i), (GamePause.dialogEntry == i ? 0xffff0000 : 0xffffff00) + Math.roundToInt(GamePause.dialogVisibility * 255.0f), 4, 0, renderQueue + 3, false)
			Renderer.drawSpriteTinted("main_menu.text_bg_small", px, 104 + (32 * i), 0, SPRITE_FLAG_FLIP_X|SPRITE_FLAG_PRIO, renderQueue + 2, 0, (GamePause.dialogEntry == i ? 0xffffff00 : 0x00000000) + Math.roundToInt(GamePause.dialogVisibility * 255.0f), 1.0f)
		}
	}

	if (GamePause.screenshotHint > 0.0f && !GamePause.useTouchInput)
	{
		float hintVisibility = GamePause.screenshotHint * GamePause.visibility
		py = getScreenHeight() - 5 + Math.roundToInt(Math.lerp(20, -2, hintVisibility))

		Renderer.drawSprite("@input_icon_button_Y", 12, py - 1, 0, SPRITE_FLAG_PRIO | SPRITE_FLAG_NO_GLOBAL_TINT, renderQueue + 1, 0, 0xdd)
		Renderer.drawText("oxyfont_tiny_narrow", 20, py, stringformat(": %s", Standalone.getTranslatedString("pause", 11)), 0xffffff88, 4, 0, renderQueue + 1, false)
	}

	if (GamePause.useTouchInput)
	{
		px = 96 + (GamePause.selectedEntry == 254 ? 16 : 0) - Math.roundToInt(192.0f - (GamePause.visibility * 192.0f))
		py = getScreenHeight() - 24

		Renderer.drawText("oxyfont_small", px - 16, py, Standalone.getTranslatedString("pause", 10), GamePause.selectedEntry == 254 ? 0xffff00ff : 0xffffffff - Math.roundToInt(GamePause.dialogVisibility * 255.0f), 6, 0, renderQueue + 3, false)
		Renderer.drawSpriteTinted("main_menu.text_bg_small", px, py, 0, SPRITE_FLAG_PRIO, renderQueue + 2, 0, (GamePause.selectedEntry == 254 ? 0xffffffff : 0x000000ff) - Math.roundToInt(GamePause.dialogVisibility * 255.0f), 1.0f)
	}

	Renderer.drawSprite("main_menu.circle", getScreenWidth() + 56 + Math.roundToInt(192.0f - (GamePause.visibility * 192.0f)), getScreenCenterY() + 5, 0, SPRITE_FLAG_PRIO, renderQueue + 1)

	Renderer.drawSprite("main_menu.triangles", Math.roundToInt(time * 60.0f) % 256, Math.roundToInt((GamePause.visibility * 32.0f) - 32.0f), 0, SPRITE_FLAG_PRIO, renderQueue)
	Renderer.drawSprite("main_menu.triangles", (Math.roundToInt(time * 60.0f) % 256) + 512, Math.roundToInt((GamePause.visibility * 32.0f) - 32.0f), 0, SPRITE_FLAG_PRIO, renderQueue)
	Renderer.drawSprite("main_menu.triangles", -(Math.roundToInt(time * 60.0f) % 256), getScreenHeight() - Math.roundToInt((GamePause.visibility * 32.0f) - 32.0f), 0, SPRITE_FLAG_PRIO, renderQueue)
	Renderer.drawSprite("main_menu.triangles", -(Math.roundToInt(time * 60.0f) % 256) + 512, getScreenHeight() - Math.roundToInt((GamePause.visibility * 32.0f) - 32.0f), 0, SPRITE_FLAG_PRIO, renderQueue)

	Renderer.drawRect(0, 0, getScreenWidth(), getScreenHeight(), 0x0000ff00 + u32(Math.roundToInt(GamePause.visibility * 96.0f)), renderQueue - 1, false)
}


function u8 GamePause.getButtonResultFromTouch()
{
	Renderer.setLifetimeContext(1)

	s16 px = 0
	if (GamePause.isDialogOpen)
	{
		u8 numDialogEntries = (GamePause.selectedEntry == 1) ? 3 : (GamePause.selectedEntry == 3) ? 2 : 0
		for (u8 i = 0; i < numDialogEntries; ++i)
		{
			px = getScreenWidth() - 144 + Math.roundToInt(192.0f - (GamePause.visibility * 192.0f))
			//Renderer.drawRect(px, 104 + (32 * i) - 8, 400, 16, 0xeeffffff, 0xffff, false)
			if (checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, px, 104 + (32 * i) - 8, 400, 16))
				return i + 1
		}
	}
	else
	{
		u8 entriesAdded = 0
		u8 i = 0
		for (i = 0; i < GamePause.NUM_ENTRIES; ++i)
		{
			if (!GamePause.IsValidEntry(i))
				continue

			++entriesAdded
		}
		s16 py = 0
		bool removedEntry = false
		for (i = 0; i < entriesAdded + 1; ++i)
		{
			if (i == entriesAdded)
			{
				px = 0
				py = getScreenHeight() - 24

				//Renderer.drawRect(px, py - 8, 96, 16, 0xeeffffff, 0xffff, false)
				if (checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, px, py - 8, 96, 16))
					return 255
				return 0
			}

			s16 py_ref = Math.lerp(37, getScreenHeight() - 37, float(i) / float(entriesAdded - 1))
			if (!GamePause.IsValidEntry(i))
			{
				++i
				++entriesAdded
				removedEntry = true
			}
			else if (!GamePause.IsValidEntry(i - 1) && removedEntry)
			{
				--i
				--entriesAdded
				removedEntry = false
			}
			py = GamePause.selectedEntry == i ? Math.lerp(py_ref, 64, GamePause.dialogVisibility) : py_ref
			s16 sprOffset = Math.roundToInt(96.0f * Math.sin(2.0f * 3.1415f * 76.0f * float(py)))
			px = sprOffset + getScreenWidth() - 100 + Math.roundToInt(192.0f - (GamePause.visibility * 192.0f))

			//Renderer.drawRect(px, py - 12, 400, 24, 0xeeffffff, 0xffff, false)
			if (checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, px, py - 12, 400, 24))
				return i + 1

			py += 38
		}
	}

	return 0
}


#else	// STANDALONE


//-------------------------------------------------------//
// Game pause (original implementation)                  //
//-------------------------------------------------------//

//# address-hook(0x0013e4) end(0x0014e4)
function void UpdateGamePause()
{
	// This is only used in outro; and there's no actual need to prevent game pause there
	if (global.pause_disabled)
		return

	if (lives_counter <= 0)
	{
		global.game.paused = false
		return
	}

	if (!global.game.paused)
	{
		// Start button pressed?
		if ((control.pad1.pressed & CONTROL_START) == 0)
			return

		// Entering game pause
		global.game.paused = true
	}

	syncZ80_variantB(0x01)

	while (true)
	{
		global.frame_state = 0x10
		waitForNextFrame()
	@EntryPoint:

		if (pausecheats.unlocked)
		{
			if (control.pad1.pressed & CONTROL_A)
			{
				global.game_mode = 0x04		// Title Screen
				break
			}

			if (control.pad1.state & CONTROL_B || control.pad1.pressed & CONTROL_C)
			{
				// Single step
				global.game.paused = true
				syncZ80_variantB(0x80)
				return
			}
		}

		// In competition mode, button B during pause quits the stage
		if (global.zone >= 0x0e && global.zone <= 0x12)
		{
			if ((control.pad1.pressed & CONTROL_B) && (competition_mode.game_mode < 0))
			{
				global.game_mode = 0xc0		// Competition Mode Level Select, fading
				break
			}
		}

		if (control.pad1.pressed & CONTROL_START)
			break
	}

	syncZ80_variantB(0x80)

	global.game.paused = false
}

#endif
