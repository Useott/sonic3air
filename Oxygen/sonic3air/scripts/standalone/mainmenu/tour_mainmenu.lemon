// Functions for Angel Island Tour's new menus.

global u8 TourMenus.MaxEntries
global bool TourMenus.allowEncore = false
global string TourMenus.splashText = "missingno"

function void TourMenus.beforeMainMenuOpens()
{
}

function void TourMenus.setMaxEntryNumber()
{
	TourMenus.MaxEntries = 6 + TourMenus.allowEncore
}

function void TourMenus.EnterCustomMenu(u8 menu)
{
}

function string TourMenus.GetCustomMenuName(u8 menu)
{
	return ""
}

function string TourMenus.getRandomSplashText()
{
	if (System.getSystemClockData(DATE_DAY) == 22 && System.getSystemClockData(DATE_MONTH) == 3)
	{
		if (System.rand() % 8 == 0)
			return "Happy birthday Useott!"
	}

	u32 bytes = System.loadExternalRawData("main_menu_splashes", 0x800000)
	// First, get the number of lines
	u16 numLines = 0
	u32 i
	for (i = 0; i < bytes; ++i)
	{
		if (u8[0x800000 + i] == 0x0a)
			++numLines
	}

	// Then, pick one at random
	u16 chosenLine = System.rand() % numLines
	u16 lineNum = 0
	u32 lineStart = 0
	for (i = 0; i < bytes; ++i)
	{
		if (u8[0x800000 + i] == 0x0a)
		{
			++lineNum
			if (lineNum == chosenLine)
				lineStart = i + 1
			else if (lineNum == chosenLine + 1)
			{
				string splash
				for (u32 char = lineStart; char < i; ++char)
				{
					// Ignore comments, such as this
					if (u16[0x800000 + char] == 0x2f2f)
						break
					splash += getStringFromCharacter(u8[0x800000 + char])
				}

				return splash
			}
		}
	}

	return "missingno"
}

function void TourMenus.Menu()
{
	bool useTriangleFade = u16[0xffffeee4]
	TourMenus.splashText = TourMenus.getRandomSplashText()
	u32 touchMemBackup = u32[0x801004]
	zeroMemory(0xff0000, 0xffff)
	zeroMemory(0x800000, 0xfffff)
	u32[0x801004] = touchMemBackup
	Init() // This doesn't seem to do any bad
	TourMenus.beforeMainMenuOpens()
	TourMenus.setMaxEntryNumber()
	setMenuMusic()

	u16 screenTouchCounter = 0
	u16 framesSinceLastTouch = 0
	bool ignoreFramesSinceLastTouch

	u8 exitHoldTimer = 0

	u32 framecounter = 0
	u8 selectedEntry = touchdebug.use_touch_controls ? 255 : 0

	u8 actSelChar
	u8 actSelZone
	u8 actSelAct
	u8 actSelEmeralds

	u8 currentMenu
	constant u8 menu.MAIN_MENU = 0
	constant u8 menu.ACT_SELECT = 1
	constant u8 menu.TIME_ATTACK = 2

	u8 result
	constant u8 MENU = 0
	constant u8 NORMAL_GAME = 1
	constant u8 ENCORE_GAME = 2
	constant u8 ACT_SELECT = 3
	constant u8 TIME_ATTACK = 4
	constant u8 OPTIONS = 5
	constant u8 EXTRAS = 6
	constant u8 MODS = 7
	constant u8 EXIT = 126
	constant u8 CUSTOM = 127
	constant u8 TITLE_SCREEN = 255

	u8 transitionTimer
	u8 lastMenu
	u8 lastEntry

	for (u16 i; i < 0xffff; ++i)
	{
		VDP.setupVRAMWrite(u16(i) * 4)
		VDP.writeData32(0)
	}
	VDP.Config.setNameTableBasePlaneB(0)
	VDP.Config.setNameTableBasePlaneA(0)

	playMenuMusic()

	levelselect.characters = 0
	global.zone = 0
	global.act = 0
	global.traded_emeralds = 0

	Renderer.resetSprites()
	TourMenus.drawMenuBackground(0, framecounter)
	TourMenus.drawMenu(0, selectedEntry, framecounter, 0x4000)
	TourMenus.handleFading(useTriangleFade ? 2 : 0)

	while (result == MENU)
	{
		@MenuWhileLoop:
		u8[0x80100c] = 0
		++framecounter

		Renderer.resetSprites()
		if (currentMenu == menu.ACT_SELECT)
		{
			levelselect.characters = actSelChar
			global.zone = actSelZone
			global.act = actSelAct
			global.traded_emeralds = actSelEmeralds
		}

		TourMenus.drawMenuBackground(0, framecounter)

		if (transitionTimer)
		{
			s16 px = Math.lerp(-32, s16(getScreenWidth()), float(transitionTimer) / 20.0f)
			Renderer.drawSprite("main_menu.transition_separator", px, 0, 0, SPRITE_FLAG_PRIO, 0xa000)
			--transitionTimer

			if (px <= 0)
				px = 0

			D4.u8 = 1

			Renderer.setViewport(px, 0, getScreenWidth(), getScreenHeight(), 0x4000)
			TourMenus.drawMenu(currentMenu, selectedEntry, framecounter, 0x4001)
			Renderer.resetViewport(0x4010)

			Renderer.setViewport(0, 0, px, getScreenHeight(), 0x5000)
			TourMenus.drawMenu(lastMenu, lastEntry, framecounter, 0x5001)
			Renderer.resetViewport(0x5010)
		}
		else
		{
			D4.u8 = 0
			TourMenus.drawMenu(currentMenu, selectedEntry, framecounter, 0x4000)
			lastEntry = selectedEntry
			lastMenu = currentMenu
		}

		framesSinceLastTouch += 1
		if (screenTouchX || screenTouchY)
		{
			ignoreFramesSinceLastTouch = false
			if (transitionTimer == 0)
			{
				if (currentMenu == menu.MAIN_MENU)
				{
					if (selectedEntry != TourMenus.getMainMenuButtonResultFromTouch() - 1)
					{
						selectedEntry = TourMenus.getMainMenuButtonResultFromTouch() - 1
						if (selectedEntry < 255)
							playSound(0x5b)
					}
				}
				else if (currentMenu == menu.ACT_SELECT)
				{
					if (selectedEntry != TourMenus.getActSelectButtonResultFromTouch() - 1)
					{
						selectedEntry = TourMenus.getActSelectButtonResultFromTouch() - 1
						if (selectedEntry < 255)
							playSound(0x5b)
					}
				}
			}
			framesSinceLastTouch = 0
		}

		if (transitionTimer == 0)
		{
			if (currentMenu == menu.MAIN_MENU)
			{
				s16 px = (!touchdebug.use_touch_controls ? 64 : 20) + Renderer.getTextWidth("oxyfont_small", TourMenus.getMainMenuTexts(19)) + (selectedEntry == 254 ? 16 : 0) - 9
				if ((Input.buttonDown(BUTTON_Y) && Input.buttonDown(BUTTON_DOWN)) || (touchdebug.use_touch_controls && checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, 0, getScreenHeight() - 32, px, 16)))
				{
					exitHoldTimer += 2
					if (exitHoldTimer >= 32)
						result = EXIT
				}
				else if (Input.buttonPressed(BUTTON_DOWN))
				{
					selectedEntry += 1

					if (selectedEntry >= TourMenus.MaxEntries)
						selectedEntry = 0

					playSound(0x5b)
				}
				else if (Input.buttonPressed(BUTTON_UP))
				{
					selectedEntry -= 1

					if (selectedEntry >= TourMenus.MaxEntries)
						selectedEntry = TourMenus.MaxEntries - 1

					playSound(0x5b)
				}
				else if (Input.buttonPressed(BUTTON_A) || Input.buttonPressed(BUTTON_START) || ((touchdebug.use_touch_controls && !(screenTouchX || screenTouchY) && framesSinceLastTouch > 0 && framesSinceLastTouch < 5) && screenTouchCounter < 20))
				{
					if (selectedEntry == 0)
						result = NORMAL_GAME
					else if (selectedEntry == 1)
						result = ENCORE_GAME
					else if (selectedEntry == 2)
						result = ACT_SELECT
					else if (selectedEntry == 3)
						result = TIME_ATTACK
					else if (selectedEntry == 4)
						result = OPTIONS
					else if (selectedEntry == 5)
						result = EXTRAS
					else if (selectedEntry == 6)
						result = MODS
					else if (selectedEntry == 7)
						result = EXIT
					else if (selectedEntry == 254)
						result = TITLE_SCREEN
					else if (selectedEntry != 255)
						result = CUSTOM

					if (!TourMenus.allowEncore && result >= ENCORE_GAME && result <= MODS)
						result += 1
				}

				if (exitHoldTimer > 0)
				{
					--exitHoldTimer
					s16 py = getScreenHeight() - 17
					Renderer.drawRect(0, py, Math.lerp(0, px, float(exitHoldTimer) / 30.8f), 1, 0xffb100ff, 0x8000, false)
				}

				if (Input.buttonPressed(BUTTON_B) || Input.buttonPressed(BUTTON_BACK))
					result = TITLE_SCREEN
			}
			else
			{
				exitHoldTimer = 0

				if (currentMenu == menu.ACT_SELECT)
				{
					u8 maxButtons = Game.isSecretUnlocked(SECRET_EMERALD_SELECT) ? 4 : 3

					if (Input.buttonPressed(BUTTON_DOWN))
					{
						selectedEntry += 1
						if (selectedEntry >= maxButtons)
							selectedEntry = 0

						playSound(0x5b)
					}
					else if (Input.buttonPressed(BUTTON_UP))
					{
						selectedEntry -= 1
						if (selectedEntry >= maxButtons)
							selectedEntry = maxButtons - 1

						playSound(0x5b)
					}

					u8 entryValue = selectedEntry == 0 ? actSelChar : selectedEntry == 1 ? actSelZone : selectedEntry == 2 ? actSelAct : actSelEmeralds
					u8 entryValueLimit = selectedEntry == 0 ? ActSelect.GetNumCharacterCombinations() : selectedEntry == 1 ? ActSelect.GetNumZones() : selectedEntry == 2 ? ActSelect.GetNumActs(actSelZone) : ActSelect.GetNumEmeraldTypes() + 1

					ignoreFramesSinceLastTouch = true
					if (Input.buttonPressed(BUTTON_LEFT) || (TourMenus.getActSelectButtonResultFromTouch2(selectedEntry) == 1 && framesSinceLastTouch == 0 && screenTouchCounter == 1))
					{
						entryValue -= 1
						// MISC compatbility
						{
							levelselect.characters = entryValue
							if (selectedEntry == 0)
							{
								if (ActSelect.GetCharacterCombinationName(entryValue) == 0)
								{
									for (u16 chr = 1 + u16(entryValueLimit); chr > 0; --chr)
									{
										entryValue -= 1
										levelselect.characters = entryValue
										if (ActSelect.GetCharacterCombinationName(entryValue) != 0)
											break
									}
								}
							}
						}
						if (entryValue >= entryValueLimit)
						{
							entryValue = entryValueLimit - 1
							if (selectedEntry == 2)
							{
								actSelZone -= 1
								if (actSelZone >= ActSelect.GetNumZones())
									actSelZone = ActSelect.GetNumZones() - 1
							}
						}
					}
					else if (Input.buttonPressed(BUTTON_RIGHT) || (TourMenus.getActSelectButtonResultFromTouch2(selectedEntry) == 2 && framesSinceLastTouch == 0 && screenTouchCounter == 1))
					{
						entryValue += 1
						// MISC compatbility
						{
							levelselect.characters = entryValue
							if (selectedEntry == 0)
							{
								if (ActSelect.GetCharacterCombinationName(entryValue) == 0)
								{
									for (u16 chr = 0; chr < 1 + u16(entryValueLimit); ++chr)
									{
										entryValue += 1
										levelselect.characters = entryValue
										if (ActSelect.GetCharacterCombinationName(entryValue) != 0)
											break
									}
								}
							}
						}
						if (entryValue >= entryValueLimit)
						{
							entryValue = 0
							if (selectedEntry == 2)
							{
								actSelZone += 1
								if (actSelZone >= ActSelect.GetNumZones())
									actSelZone = 0
							}
						}
					}

					if (Input.buttonPressed(BUTTON_LEFT) || Input.buttonPressed(BUTTON_RIGHT) || (TourMenus.getActSelectButtonResultFromTouch2(selectedEntry) && framesSinceLastTouch == 0 && screenTouchCounter == 1))
					{
						if (selectedEntry == 0)
							actSelChar = entryValue
						else if (selectedEntry == 1)
						{
							actSelZone = entryValue
							if (actSelAct >= ActSelect.GetNumActs(actSelZone))
								actSelAct = ActSelect.GetNumActs(actSelZone) - 1
						}
						else if (selectedEntry == 2)
						{
							actSelAct = entryValue
							if (actSelAct >= ActSelect.GetNumActs(actSelZone))
								actSelAct = ActSelect.GetNumActs(actSelZone) - 1
						}
						else actSelEmeralds = entryValue
						playSound(0x5b)
						screenTouchCounter += 1
						screenTouchX = 0
						screenTouchY = 0
					}

					if (Input.buttonPressed(BUTTON_START) || ((touchdebug.use_touch_controls && !(screenTouchX || screenTouchY) && framesSinceLastTouch > 0 && framesSinceLastTouch < 5) && screenTouchCounter < 20 && selectedEntry == 253))
					{
						levelselect.characters = actSelChar
						global.zone_act = ActSelect.TranslateZoneAct(actSelZone, actSelAct)
						Audio.playAudio(0xaf)
						TourMenus.handleFading(1)
						Input.setTouchInputMode(TOUCH_INPUT_MODE_NORMAL_CONTROLS)
						EntryFunctions.actSelect()
					}

					if (Input.buttonPressed(BUTTON_B) || Input.buttonPressed(BUTTON_BACK) || ((touchdebug.use_touch_controls && !(screenTouchX || screenTouchY) && framesSinceLastTouch > 0 && framesSinceLastTouch < 5) && screenTouchCounter < 20 && selectedEntry == 254))
					{
						Audio.playAudio(0xad)
						transitionTimer = 20
						currentMenu = menu.MAIN_MENU
						if (touchdebug.use_touch_controls)
							selectedEntry = 255
						else selectedEntry = 1 + TourMenus.allowEncore
					}
				}
			}
		}

		yieldExecution()

		if ((screenTouchX || screenTouchY))
			screenTouchCounter += 1
		else if (!(screenTouchX || screenTouchY) && (framesSinceLastTouch > 20 || ignoreFramesSinceLastTouch))
			screenTouchCounter = 0
	}

	if (currentMenu == menu.MAIN_MENU)
	{
		if (result == NORMAL_GAME)
		{
			Audio.playAudio(0x63)
			Input.setTouchInputMode(TOUCH_INPUT_MODE_NORMAL_CONTROLS)
			Audio.fadeOutChannel(0, 0.2f)
			TourMenus.handleFading(3)
			EntryFunctions.dataSelect()
			return
		}
		if (result == ENCORE_GAME)
		{
			Audio.playAudio(0x63)
			Input.setTouchInputMode(TOUCH_INPUT_MODE_NORMAL_CONTROLS)
			Audio.fadeOutChannel(0, 0.2f)
			TourMenus.handleFading(3)
			//EntryFunctions.dataSelect()
			EntryFunctions.encoreDataSelect()
			return
		}
		if (result == ACT_SELECT)
		{
			Audio.playAudio(0x63)
			result = MENU
			currentMenu = menu.ACT_SELECT
			selectedEntry = touchdebug.use_touch_controls ? 255 : 0
			transitionTimer = 20
			jump @MenuWhileLoop
		}
		if (result == TIME_ATTACK)
		{
			Audio.playAudio(0x63)
			TourMenus.handleFading(1)
			Game.openTimeAttackMenu()
			Renderer.drawRect(0, 0, getScreenWidth(), getScreenHeight(), 255, 0xff80, false)
			TourMenus.handleFading(0)
			currentMenu = menu.TIME_ATTACK // We actually leave the lemonscript menu running, to use the touch controls.
			u8[0x801008] = 0
			u8[0x801009] = 2
			u8[0x80100a] = 2
			u8[0x80100b] = 0
			while (true)
			{
				u8[0x80100c] = 1

				// This is where the entire time attack lemon code resides. Rendering is done through C++, Lemon is only doing touch screen stuff.
				s16 px = 176
				s16 py = 128
				if (!(screenTouchX || screenTouchY) && u8[0x80100b] >= 10)
				{
					u8[0x80100b] -= 10
				}
				else u8[0x80100b] = 0
				for (u8 i = 0; i < 7; ++i)
				{
					if (i == 3)
					{
						px = getScreenWidth() - 72 - (getScreenExtend())
						py = 160
						if (checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, px - 16, py - 12, getScreenWidth() - px, 24))
							u8[0x80100b] = 11
					}
					else if (i == 4)
					{
						px = 0
						py = 24
						if (checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, px, py - 8, 64, 16))
							u8[0x80100b] = 12
					}
					else if (i == 5)
					{
						px = 204
						py = 128 + (u8[0x801008] * 26)
						if (checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, px - 8, py - 8, 16, 16) && u8[0x801009] == 2)
							u8[0x801009] = 3
						else if (screenTouchX || screenTouchY)
							u8[0x801009] = 10
						else u8[0x801009] = 2
						continue
					}
					else if (i == 6)
					{
						px = 204
						py = 128 + (u8[0x801008] * 26)
						if (checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, px - 160, py - 8, 16, 16) && u8[0x80100a] == 2)
							u8[0x80100a] = 1
						else if (screenTouchX || screenTouchY)
							u8[0x80100a] = 10
						else u8[0x80100a] = 2
						continue
					}
					else if (checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, px - 128, py - 8, 160, 16))
						u8[0x801008] = i

					py += 26
				}

				if (u8[0x80100a] == 1)
					u8[0x801009] = u8[0x80100a]
				yieldExecution()
			}
			Game.returnToMainMenu()
			u8[0x80100c] = 0
		}
		if (result == OPTIONS)
		{
			Audio.playAudio(0x63)
			Input.setTouchInputMode(TOUCH_INPUT_MODE_NORMAL_CONTROLS)
			TourMenus.handleFading(1)
			Game.openOptionsMenuFromAITMenu()
			Renderer.drawRect(0, 0, getScreenWidth(), getScreenHeight(), 255, 0xff80, false)
			TourMenus.handleFading(0)
			Game.returnToMainMenu()
		}
		if (result == EXTRAS)
		{
			Audio.playAudio(0x63)
			Input.setTouchInputMode(TOUCH_INPUT_MODE_NORMAL_CONTROLS)
			TourMenus.handleFading(3)
			EntryFunctions.extrasMenu()
			return
		}
		if (result == MODS)
		{
			Audio.playAudio(0x63)
			Input.setTouchInputMode(TOUCH_INPUT_MODE_NORMAL_CONTROLS)
			TourMenus.handleFading(1)
			Game.openModsMenu()
			Renderer.drawRect(0, 0, getScreenWidth(), getScreenHeight(), 255, 0xff80, false)
			TourMenus.handleFading(0)
			Game.returnToMainMenu()
		}
		if (result == TITLE_SCREEN)
		{
			Audio.playAudio(0xad)
			global.game_mode = 0x04
			TourMenus.handleFading(1)
			GameModeControlLoop()
			return
		}
		if (result == EXIT)
		{
			Audio.playAudio(0xad)
			TourMenus.handleFading(1)
			for (u8 i; i < 50; ++i)
				yieldExecution()
			Game.exit()
		}
		if (result == CUSTOM)
		{
			Audio.playAudio(0x63)
			Input.setTouchInputMode(TOUCH_INPUT_MODE_NORMAL_CONTROLS)
			TourMenus.handleFading(3)
			TourMenus.EnterCustomMenu(selectedEntry)
			return
		}
	}
}

function void TourMenus.drawMenuBackground(u8 menu, u32 framecounter)
{
	TourMenus.drawMenuBackground(menu, framecounter, 0x1000, 0x2000)
}

function void TourMenus.drawMenuBackground(u8 menu, u32 framecounter, u16 renderQueue1, u16 renderQueue2)
{
	if (menu == 0)
	{
		// Before you change this, it's important to know this does NOT affect the Time Attack, Settings and Mods menus. The code for those menus were ported from the original Lemon script code, but still are written in C++.
		s16 px = -(framecounter / 8) % 512
		s16 py = Math.roundToInt(2.0f * Math.sin(2 * 3.1415 * 128 * float(u8(framecounter)))) - 8
		if (System.getSystemClockData(DATE_MONTH) == 12)
		{
			s16 px2 = -(framecounter / 4) % 512
			Renderer.drawSprite("main_menu.background_december", 0, 0, 0, 0, renderQueue1)

			Renderer.setViewport(0, 180, getScreenWidth(), 16, renderQueue1 + 1)

			Renderer.drawSprite("main_menu.background_december", px, 0, 0, 0, renderQueue1 + 2)
			Renderer.drawSprite("main_menu.background_december", px + 512, 0, 0, 0, renderQueue1 + 2)

			Renderer.resetViewport(renderQueue1 + 3)
			Renderer.setViewport(0, 196, getScreenWidth(), 60, renderQueue1 + 4)

			Renderer.drawSprite("main_menu.background_december", px2, 0, 0, 0, renderQueue1 + 5)
			Renderer.drawSprite("main_menu.background_december", px2 + 512, 0, 0, 0, renderQueue1 + 5)

			Renderer.resetViewport(renderQueue1 + 6)

			Renderer.drawSprite("main_menu.foreground_december", 0, 0, 0, 0, renderQueue2)
		}
		else if (System.getSystemClockData(DATE_MONTH) == 10)
		{
			Renderer.drawSprite("main_menu.background_october", px, 0, 0, 0, renderQueue1)
			Renderer.drawSprite("main_menu.background_october", px + 512, 0, 0, 0, renderQueue1)

			for (u16 i; i < 64; ++i)
			{
				float waveMul = Math.lerp(0.125f, 1.0f, float(i) / 64.0f)
				px = -(framecounter / 8) % 512 + Math.roundToInt((10.0f * waveMul) * Math.sin(2.0f * 3.1415f * 384 * float(i * 4) + float(u16(framecounter) / 41.0f)))
				Renderer.setViewport(0, 160 + i, getScreenWidth(), 1, renderQueue1 + 1 + (i * 3))
				Renderer.drawSprite("main_menu.background_october", px % 512, 0, 0, 0, renderQueue1 + 2 + (i * 3))
				Renderer.drawSprite("main_menu.background_october", px % 512 + 512, 0, 0, 0, renderQueue1 + 2 + (i * 3))
				Renderer.resetViewport(renderQueue1 + 3 + (i * 3))
			}
		}
		else
		{
			Renderer.drawSprite("main_menu.background", px, py, 0, 0, renderQueue1)
			Renderer.drawSprite("main_menu.background", px + 512, py, 0, 0, renderQueue1)
			Renderer.drawSprite("main_menu.foreground", 0, 0, 0, 0, renderQueue2)
		}
	}
	if (menu == 1)
	{
		Renderer.drawSprite("extras.background", 0, 0, 0, 0, renderQueue2)
	}
	if (menu == 2)
	{
		s16 px = -(framecounter / 8) % 512
		s16 py = Math.roundToInt(2.0f * Math.sin(2 * 3.1415 * 128 * float(u8(framecounter)))) - 8
		Renderer.drawSprite("main_menu.background", px, py - 72, 0, 0, renderQueue1)
		Renderer.drawSprite("main_menu.background", px + 512, py - 72, 0, 0, renderQueue1)
		Renderer.drawSprite("main_menu.foreground_alt", 0, 0, 0, 0, renderQueue2)
	}
}

function void TourMenus.drawMenu(u8 menu, u8 selectedEntry, u32 framecounter, u16 renderQueue)
{
	if (menu == 0)
	{
		Renderer.drawText("sonic3_fontC", getScreenCenterX(), 16, TourMenus.getMainMenuTexts(-1), 0xffffffff, 5, 0, renderQueue + 4, false)

		s16 px = 0
		s16 py = 37
		string key = "main_menu.text_bg"
		string font = "oxyfont_regular"
		for (u8 i; i < TourMenus.MaxEntries; ++i)
		{
			s16 sprOffset = Math.roundToInt(96.0f * Math.sin(2.0f * 3.1415f * 76.0f * float(py)))

			if (TourMenus.MaxEntries > 6 + TourMenus.allowEncore)
			{
				key = "main_menu.text_bg_small"
				font = "oxyfont_small"
				py = Math.lerp(32, getScreenHeight() - 32, float(i) / float(TourMenus.MaxEntries - 1))
				sprOffset = Math.roundToInt(96.0f * Math.sin(2.0f * 3.1415f * 76.0f * float(py)))
			}

			px = (selectedEntry == i ? -16 : 0) + sprOffset + getScreenWidth() - 100

			string text = TourMenus.getMainMenuTexts(i)

			if (i == 1 && TourMenus.allowEncore)
				text = TourMenus.getMainMenuTexts(24)
			if (i > 1 && TourMenus.allowEncore)
				text = TourMenus.getMainMenuTexts(i - 1)
			if (i >= 6 + TourMenus.allowEncore)
				text = TourMenus.GetCustomMenuName(i)

			Renderer.drawText(font, px + 16, py, text, selectedEntry == i ? 0xffff00ff : 0xffffffff, 4, 0, renderQueue + 3, false)
			Renderer.drawSpriteTinted(key, px, py, 0, SPRITE_FLAG_FLIP_X|SPRITE_FLAG_PRIO, renderQueue + 2, 0, selectedEntry == i ? 0xffffffff : 0x000000ff, 1.0f)

			if (TourMenus.MaxEntries <= 7)
			{
				if (i >= 2 + TourMenus.allowEncore)
				{
					key = "main_menu.text_bg_small"
					font = "oxyfont_small"
					if (i > 2 + TourMenus.allowEncore)
						py -= 12
				}
				py += 38 - (TourMenus.allowEncore * 5)
			}
		}

		if (System.hasPlatformFlag(PlatformFlags.MOBILE))
		{
			px = 64 + (selectedEntry == 254 ? 16 : 0)
			py = 24
			Renderer.drawText(font, px - 16, py, TourMenus.getMainMenuTexts(6), selectedEntry == 254 ? 0xffff00ff : 0xffffffff, 6, 0, renderQueue + 3, false)
			Renderer.drawSpriteTinted(key, px, py, 0, SPRITE_FLAG_PRIO, renderQueue + 2, 0, selectedEntry == 254 ? 0xffffffff : 0x000000ff, 1.0f)
		}

		if (System.hasPlatformFlag(PlatformFlags.WEB) || System.hasPlatformFlag(PlatformFlags.DESKTOP))
		{
			px = (!touchdebug.use_touch_controls ? 64 : 20) + Renderer.getTextWidth(font, TourMenus.getMainMenuTexts(19)) + (selectedEntry == 254 ? 16 : 0)
			py = getScreenHeight() - 24
			if (!touchdebug.use_touch_controls)
			{
				Renderer.drawSprite("@input_icon_button_Y", 11, py, 0, SPRITE_FLAG_PRIO, renderQueue + 2)
				Renderer.drawText(font, 27, py, "+", selectedEntry == 254 ? 0xffff00ff : 0xffffffff, 6, 0, renderQueue + 3, false)
				Renderer.drawSprite("@input_icon_button_down", 36, py, 0, SPRITE_FLAG_PRIO, renderQueue + 2)
			}
			Renderer.drawText(font, px - 16, py, TourMenus.getMainMenuTexts(19), selectedEntry == 254 ? 0xffff00ff : 0xffffffff, 6, 0, renderQueue + 3, false)
			Renderer.drawSpriteTinted(key, px, py, 0, SPRITE_FLAG_PRIO, renderQueue + 2, 0, selectedEntry == 254 ? 0xffffffff : 0x000000ff, 1.0f)
		}

		Renderer.drawSprite("main_menu.circle", getScreenWidth() + 56, getScreenCenterY() + 5, 0, SPRITE_FLAG_PRIO, renderQueue + 1)

		Renderer.drawSprite(System.getSystemClockData(DATE_MONTH) == 12 ? "main_menu.sonic_art_december" : System.getSystemClockData(DATE_MONTH) == 10 ? "main_menu.sonic_art_october" : "main_menu.sonic_art", 32, 56 + Math.roundToInt(4.0f * Math.sin(2 * 3.1415 * 256 * float(u8(framecounter)))), 0, SPRITE_FLAG_PRIO, renderQueue)

		u8 build.yr = Game.getBuildNumber() >> 24
		u8 build.dy = Game.getBuildNumber() >> 16
		u8 build.mt = Game.getBuildNumber() >> 8
		u8 build.nm = Game.getBuildNumber()

		string additional_text = ""
		if (System.isDevModeActive())
			additional_text += " - " + TourMenus.getMainMenuTexts(15)
		if (Game.getSetting(SETTING_FIX_GLITCHES) == 0)
			additional_text += " - " + TourMenus.getMainMenuTexts(16)
		else if (Game.getSetting(SETTING_FIX_GLITCHES) == 1)
			additional_text += " - " + TourMenus.getMainMenuTexts(17)
		Renderer.drawText("oxyfont_tiny_narrow", 2, getScreenHeight() - 2, stringformat("Angel Island Tour v%02x.%02x.%02x.%02x%s - %s", build.yr, build.dy, build.mt, build.nm, additional_text, TourMenus.splashText), 0xffffff88, 7, 0, renderQueue + 4, false)
	}
	else if (menu == 1)
	{
		u8 character = levelselect.characters
		u8 zone = global.zone
		u8 act = global.act
		u8 emeralds = global.traded_emeralds

		Renderer.drawText("sonic3_fontC", getScreenCenterX(), 16, TourMenus.getMainMenuTexts(7), 0xffffffff, 5, 0, renderQueue + 4, false)
		string key

		s16 viewportx = (framecounter % 600) * 16

		if (D4.u8 == 0 && (checkBoxOverlap(0, 0, getScreenWidth(), getScreenHeight(), viewportx - 4800, 26, 4800, 80)))
			Renderer.setViewport(viewportx - 4800, 26, 4800, 80, renderQueue + 6)

		key = ActSelect.GetZonePreviewKey(zone, act, 1)

		SpriteHandle spr1 = Renderer.addSpriteHandle(key, s16(getScreenWidth() - 480) / 2, 26, renderQueue + 5)
		spr1.setPalette(key, 0)
		spr1.setFlags(SPRITE_FLAG_FULLY_OPAQUE)
		spr1.setUseGlobalComponentTint(true)

		key = ActSelect.GetZonePreviewKey(zone, act, 0)

		if (checkBoxOverlap(0, 0, getScreenWidth(), getScreenHeight(), viewportx - 4800, 26, 4800, 80))
		{
			SpriteHandle spr2 = Renderer.addSpriteHandle(key, s16(getScreenWidth() - 480) / 2, 26, renderQueue + 7)
			spr2.setPalette(key, 0)
			spr2.setFlags(SPRITE_FLAG_FULLY_OPAQUE)
			spr2.setUseGlobalComponentTint(true)
		}

		if (D4.u8 == 0 && (checkBoxOverlap(0, 0, getScreenWidth(), getScreenHeight(), viewportx - 4800, 26, 4800, 80)))
			Renderer.resetViewport(renderQueue + 8)


		// Render the border
		Renderer.drawSprite("level_preview_border_left", 0, 16, 0, 0x00, renderQueue + 1)
		Renderer.drawSpriteTransformed("level_preview_border_center", getScreenWidth() / 2, 16, 0, 0x00, renderQueue + 1, 0xffffffff, float(getScreenWidth() - 20) / 10.0f, 0.0f, 0.0f, 1.0f)
		Renderer.drawSprite("level_preview_border_right", getScreenWidth(), 16, 0, 0x00, renderQueue + 1)

		s16 px = 192
		s16 py = 128
		key = "main_menu.text_bg_small"
		string font = "oxyfont_small"
		for (u8 i; i < 4; ++i)
		{
			if (i == 3 && !Game.isSecretUnlocked(SECRET_EMERALD_SELECT))
				continue
			s16 sprOffset = Math.roundToInt(48.0f * Math.sin(2.0f * 3.1415f * 3380.0f * float(i)))
			string text = i == 0 ? ActSelect.GetCharacterCombinationName(character) : i == 1 ? ActSelect.GetZoneName(zone) : i == 2 ? (ActSelect.GetNumActs(zone) == 1 ? TourMenus.getMainMenuTexts(13) : stringformat("%s %d", TourMenus.getMainMenuTexts(14), act + 1)) : ActSelect.GetEmeraldStatusName(emeralds)

			if (selectedEntry == i)
			{
				Renderer.drawText("monofont", px + 16 - (framecounter / 15 % 2), py - 1, ">", 0xffff00ff, 6, 0, renderQueue + 5, false)
				Renderer.drawText("monofont", px - 140 + (framecounter / 15 % 2), py - 1, "<", 0xffff00ff, 6, 0, renderQueue + 5, false)
			}
			Renderer.drawText(font, px - 16, py, text, selectedEntry == i ? 0xffff00ff : 0xffffffff, 6, 0, renderQueue + 3, false)
			Renderer.drawSpriteTinted(key, px, py, 0, SPRITE_FLAG_PRIO, renderQueue + 2, 0, selectedEntry == i ? 0xffffffff : 0x000000ff, 1.0f)
			py += 26
		}
		Renderer.drawSprite(ActSelect.GetCharacterCombinationSprite(character), 32, 128, 0, SPRITE_FLAG_PRIO, renderQueue + 4)

		px = getScreenWidth() - 72 - (getScreenExtend()) - (selectedEntry == 253 ? 16 : 0)
		if (!touchdebug.use_touch_controls)
			Renderer.drawSprite("@input_icon_button_start", px + 20, 160, 0, SPRITE_FLAG_PRIO, renderQueue + 2)
		Renderer.drawText("oxyfont_regular", px + (touchdebug.use_touch_controls ? 16 : 32), 160, TourMenus.getMainMenuTexts(9), selectedEntry == 253 ? 0xffff00ff : 0xffffffff, 4, 0, renderQueue + 3, false)
		Renderer.drawSpriteTinted("main_menu.text_bg", px, 160, 0, SPRITE_FLAG_FLIP_X|SPRITE_FLAG_PRIO, renderQueue + 2, 0, selectedEntry == 253 ? 0xffffffff : 0x000000ff, 1.0f)

		if (System.hasPlatformFlag(PlatformFlags.MOBILE))
		{
			px = 64 + (selectedEntry == 254 ? 16 : 0)
			py = 24
			Renderer.drawText(font, px - 16, py, TourMenus.getMainMenuTexts(6), selectedEntry == 254 ? 0xffff00ff : 0xffffffff, 6, 0, renderQueue + 10, false)
			Renderer.drawSpriteTinted(key, px, py, 0, SPRITE_FLAG_PRIO, renderQueue + 9, 0, selectedEntry == 254 ? 0xffffffff : 0x000000ff, 1.0f)
		}
	}
	else if (menu == 2)
	{
		if (System.hasPlatformFlag(PlatformFlags.MOBILE))
		{
			bool isSelected = checkMobileBackButtonPress(0xffff0000, 0xffff0002, 0xffff0004, true)
			s16 px = 64 + (isSelected ? 16 : 0)
			s16 py = 24
			Renderer.drawText("oxyfont_small", px - 16, py, TourMenus.getMainMenuTexts(6), isSelected ? 0xffff00ff : 0xffffffff, 6, 0, 0xf001, false, true)
			Renderer.drawSpriteTinted("main_menu.text_bg_small", px, py, 0, SPRITE_FLAG_PRIO, 0xf000, 0, isSelected ? 0xffffffff : 0x000000ff, 1.0f)
		}
	}

	if (menu == 2)
	{
		Renderer.drawSprite("extras.triangles", framecounter % 256, 0, 0, SPRITE_FLAG_PRIO, renderQueue)
		Renderer.drawSprite("extras.triangles", (framecounter % 256) + 512, 0, 0, SPRITE_FLAG_PRIO, renderQueue)
		Renderer.drawSprite("extras.triangles", -(framecounter % 256), getScreenHeight(), 0, SPRITE_FLAG_PRIO, renderQueue)
		Renderer.drawSprite("extras.triangles", -(framecounter % 256) + 512, getScreenHeight(), 0, SPRITE_FLAG_PRIO, renderQueue)
	}
	else
	{
		string triangle_key = "main_menu.triangles"
		if (System.getSystemClockData(DATE_MONTH) == 10 && menu != 3)
			triangle_key = "main_menu.triangles_october"
		Renderer.drawSprite(triangle_key, framecounter % 256, 0, 0, SPRITE_FLAG_PRIO, renderQueue)
		Renderer.drawSprite(triangle_key, (framecounter % 256) + 512, 0, 0, SPRITE_FLAG_PRIO, renderQueue)
		Renderer.drawSprite(triangle_key, -(framecounter % 256), getScreenHeight(), 0, SPRITE_FLAG_PRIO, renderQueue)
		Renderer.drawSprite(triangle_key, -(framecounter % 256) + 512, getScreenHeight(), 0, SPRITE_FLAG_PRIO, renderQueue)
	}
}

function void TourMenus.handleFading(u8 type)
{
	if (type == 0)
	{
		u16 fadeProgress = 240
		while (fadeProgress > 0)
		{
			enableCustomPlaneReset = false
			Renderer.resetLifetimeContext(2)
			Renderer.setLifetimeContext(2)
			Renderer.drawRect(0, 0, getScreenWidth(), getScreenHeight(), clamp(fadeProgress, 0, 255), 0xff80, false)
			fadeProgress -= 20
			Renderer.setLifetimeContext(0)
			yieldExecution()
		}
	}
	else if (type == 1)
	{
		u16 fadeProgress = 0
		while (fadeProgress <= 260)
		{
			enableCustomPlaneReset = false
			Renderer.resetLifetimeContext(2)
			Renderer.setLifetimeContext(2)
			Renderer.drawRect(0, 0, getScreenWidth(), getScreenHeight(), clamp(fadeProgress, 0, 255), 0xff80, false)
			fadeProgress += 20
			Renderer.setLifetimeContext(0)
			yieldExecution()
		}
	}
	else if (type == 2)
	{
		u16 fadeProgress = 320
		while (fadeProgress > 0)
		{
			enableCustomPlaneReset = false
			Renderer.resetLifetimeContext(2)
			Renderer.setLifetimeContext(2)
			Renderer.drawSprite("main_menu.fade_triangles", s16(fadeProgress) - 360, 0, 0, SPRITE_FLAG_PRIO, 0xff80)
			Renderer.drawSprite("main_menu.fade_triangles", getScreenWidth() + 360 - fadeProgress, 256, 0, SPRITE_FLAG_PRIO | SPRITE_FLAG_FLIP_X | SPRITE_FLAG_FLIP_Y, 0xff80)
			fadeProgress -= 20
			Renderer.setLifetimeContext(0)
			yieldExecution()
		}
	}
	else if (type == 3)
	{
		u16 fadeProgress = 0
		while (fadeProgress <= 260)
		{
			enableCustomPlaneReset = false
			Renderer.resetLifetimeContext(2)
			Renderer.setLifetimeContext(2)
			Renderer.drawSprite("main_menu.fade_triangles", s16(fadeProgress) - 260, 0, 0, SPRITE_FLAG_PRIO, 0xff80)
			Renderer.drawSprite("main_menu.fade_triangles", getScreenWidth() + 260 - fadeProgress, 256, 0, SPRITE_FLAG_PRIO | SPRITE_FLAG_FLIP_X | SPRITE_FLAG_FLIP_Y, 0xff80)
			fadeProgress += 20
			Renderer.setLifetimeContext(0)
			yieldExecution()
		}
	}
}

// Main Menu only

function u8 TourMenus.getMainMenuButtonResultFromTouch()
{
	//Renderer.drawRect(screenTouchX - 2, screenTouchY - 2, 4, 4, 0xffffffff, 0xffff, false)
	s16 px = 0
	s16 py = 37
	for (u8 i; i < TourMenus.MaxEntries + 1; i++)
	{
		/*s16 sprOffset = Math.roundToInt(96.0f * Math.sin(2.0f * 3.1415f * 76.0f * float(py)))

		if (TourMenus.MaxEntries > 6 + TourMenus.allowEncore)
		{
			key = "main_menu.text_bg_small"
			font = "oxyfont_small"
			py = Math.lerp(32, getScreenHeight() - 32, float(i) / float(TourMenus.MaxEntries - 1))
			sprOffset = Math.roundToInt(96.0f * Math.sin(2.0f * 3.1415f * 76.0f * float(py)))
		}

		px = (selectedEntry == i ? -16 : 0) + sprOffset + getScreenWidth() - 100

		string text = TourMenus.getMainMenuTexts(i)

		if (i == 1 && TourMenus.allowEncore)
			text = TourMenus.getMainMenuTexts(24)
		if (i > 1 && TourMenus.allowEncore)
			text = TourMenus.getMainMenuTexts(i - 1)
		if (i >= 6 + TourMenus.allowEncore)
			text = TourMenus.GetCustomMenuName(i)

		Renderer.drawText(font, px + 16, py, text, selectedEntry == i ? 0xffff00ff : 0xffffffff, 4, 0, renderQueue + 3, false)
		Renderer.drawSpriteTinted(key, px, py, 0, SPRITE_FLAG_FLIP_X|SPRITE_FLAG_PRIO, renderQueue + 2, 0, selectedEntry == i ? 0xffffffff : 0x000000ff, 1.0f)

		if (TourMenus.MaxEntries <= 7)
		{
			if (i >= 2 + TourMenus.allowEncore)
			{
				key = "main_menu.text_bg_small"
				font = "oxyfont_small"
				if (i > 2 + TourMenus.allowEncore)
					py -= 12
			}
			py += 38 - (TourMenus.allowEncore * 5)
		}*/


		if (i == TourMenus.MaxEntries)
		{
			px = 0
			py = 24

			if (checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, px, py - 8, 64, 16))
				return 255
			return 0
		}

		s16 sprOffset = Math.roundToInt(96.0f * Math.sin(2.0f * 3.1415f * 76.0f * float(py)))

		if (TourMenus.MaxEntries > 6 + TourMenus.allowEncore)
		{
			py = Math.lerp(32, getScreenHeight() - 32, float(i) / float(TourMenus.MaxEntries - 1))
			sprOffset = Math.roundToInt(96.0f * Math.sin(2.0f * 3.1415f * 76.0f * float(py)))
		}

		px = sprOffset + getScreenWidth() - 100

		//Renderer.drawRect(px, py - (i > 2 ? 8 : 12), 400, i > 2 ? 16 : 24, 0xeeffffff, 0xffff, false)
		if (checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, px, py - (i > 2 ? 8 : 12), 400, i > 2 ? 16 : 24))
			return i + 1

		if (TourMenus.MaxEntries <= 7)
		{
			if (i >= 2 + TourMenus.allowEncore)
			{
				if (i > 2 + TourMenus.allowEncore)
					py -= 12
			}
			py += 38 - (TourMenus.allowEncore * 5)
		}
	}

	return 0
}

function string TourMenus.getMainMenuTexts(s8 num)
{
	return Standalone.getTranslatedString("main_menu", num + 1)
}

// Act Select only

function u8 TourMenus.getActSelectButtonResultFromTouch()
{
	//Renderer.drawRect(screenTouchX - 2, screenTouchY - 2, 4, 4, 0xffffffff, 0xffff, false)
	s16 px = 176
	s16 py = 128
	for (u8 i; i < 6; ++i)
	{
		if (i == 3 && !Game.isSecretUnlocked(SECRET_EMERALD_SELECT))
			continue

		if (i == 4)
		{
			px = getScreenWidth() - 72 - (getScreenExtend())
			py = 160
			//Renderer.drawRect(px, py - 12, getScreenWidth() - px, 24, 0xeeffffff, 0xffff, false)
			if (checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, px - 16, py - 12, getScreenWidth() - px, 24))
				return 254
			continue
		}

		if (i == 5)
		{
			px = 0
			py = 24

			//Renderer.drawRect(px, py - 8, 64, 16, 0xeeffffff, 0xffff, false)
			if (checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, px, py - 8, 64, 16))
				return 255
			return 0
		}

		//Renderer.drawRect(px - 128, py - 8, 160, 16, 0xeeffffff, 0xffff, false)
		if (checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, px - 128, py - 8, 160, 16))
			return i + 1

		py += 26
	}

	return 0
}

function u8 TourMenus.getActSelectButtonResultFromTouch2(u8 selectedEntry)
{
	s16 px = 204
	s16 py = 128 + (selectedEntry * 26)
	//Renderer.drawRect(px - 8, py - 8, 16, 16, 0xeeffffff, 0xffff, false)
	if (checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, px - 8, py - 8, 16, 16))
		return 2
	//Renderer.drawRect(px - 160, py - 8, 16, 16, 0xeeffffff, 0xffff, false)
	if (checkBoxOverlap(screenTouchX - 2, screenTouchY - 2, 4, 4, px - 160, py - 8, 16, 16))
		return 1
	return 0
}

function void EntryFunctions.encoreDataSelect()
{
}
