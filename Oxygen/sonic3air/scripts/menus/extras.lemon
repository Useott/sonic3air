global string Extras.translatedString58// = Extras.getTranslatedTexts(58)
global string Extras.translatedString59// = Extras.getTranslatedTexts(59)
global string Extras.translatedString60// = Extras.getTranslatedTexts(60)
global string Extras.translatedString61// = Extras.getTranslatedTexts(61)
global string Extras.translatedString62// = Extras.getTranslatedTexts(62)
global string Extras.translatedString63// = Extras.getTranslatedTexts(63)
