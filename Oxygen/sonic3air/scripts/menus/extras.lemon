#if STANDALONE

function void Extras.initExtrasEntries()
{
	//Name, image, function to call
	
	Extras.addExtrasEntry(Extras.getTranslatedTexts(0), "secret_competitionmode", "EntryFunctions.competitionMode")
	if (Game.isSecretUnlocked(0x04))
		Extras.addExtrasEntry(Extras.getTranslatedTexts(1), "secret_bluesphere", "EntryFunctions.blueSphereGame")
	if (Game.isSecretUnlocked(0x10))
		Extras.addExtrasEntry(Extras.getTranslatedTexts(2), "secret_levelselect", "EntryFunctions.levelSelect")
}

function void Extras.initSecretsEntries()
{
	//Name (ALL UPPERCASE), description, image, id, hide until unlocked, achievements needed to unlock
	
	Extras.addSecretsEntry(Extras.getTranslatedTexts(3), Extras.getTranslatedTexts(11), "secret_dropdash", 0x01, false, 3)
	Extras.addSecretsEntry(Extras.getTranslatedTexts(4), Extras.getTranslatedTexts(12), "secret_knuckles_tails", 0x00, false, 5)
	Extras.addSecretsEntry(Extras.getTranslatedTexts(5), Extras.getTranslatedTexts(13), "secret_superpeelout", 0x03, false, 7)
	Extras.addSecretsEntry(Extras.getTranslatedTexts(6), Extras.getTranslatedTexts(14), "secret_debugmode", 0x02, false, 10)
	Extras.addSecretsEntry(Extras.getTranslatedTexts(7), Extras.getTranslatedTexts(15), "secret_bluesphere", 0x04, false, 12)
	//if (Game.isSecretUnlocked(0x10))
		Extras.addSecretsEntry(Extras.getTranslatedTexts(8), Extras.getTranslatedTexts(16), "secret_levelselect", 0x10, true, 0)
	//if (Game.isSecretUnlocked(0x11))
		Extras.addSecretsEntry(Extras.getTranslatedTexts(9), Extras.getTranslatedTexts(17), "secret_title_sk", 0x11, true, 0)
	//if (Game.isSecretUnlocked(0x12))
		Extras.addSecretsEntry(Extras.getTranslatedTexts(10), Extras.getTranslatedTexts(18), "secret_gamespeed", 0x12, true, 0)
}

